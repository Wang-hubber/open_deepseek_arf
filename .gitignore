# ============================================================================
# App 使用数据 (trace / session / memory / workspace 等运行时生成)
# ============================================================================

# Runtime logs
logs/

# Memory & traces (framework-generated at runtime, root-level only)
/memory/
/traces/

# App-specific runtime data
app/arf_default_assistant/memory/
app/arf_default_assistant/node_modules/
app/arf_default_assistant/package-lock.json

# Session trace files (numeric .md filenames in app dir)
app/arf_default_assistant/*[0-9]*.md

# Workspace directories
default/
default_workspace/

